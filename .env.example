# Celesto MicroVM Provider Configuration
CELESTO_PROVIDER=cloud
CELESTO_API_KEY=replace-with-your-celesto-api-key
CELESTO_BACKEND=firecracker

# LLM Provider Configuration
LLM_BASE_URL=https://example-llm-host/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=replace-with-a-model-name

# Trusted Control Plane Database Configuration
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger

# HTTP Control Plane API Configuration
API_PORT=8080
LOG_LEVEL=info

# Agent Recovery & Safety Configuration
RECOVERY_POLICY=rollback
MAX_RETRIES=3
SANDBOX_TIMEOUT_SECONDS=300

